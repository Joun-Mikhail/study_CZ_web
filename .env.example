# Copy this file to .env.local for local development.
# This is a static-export site (next.config.ts: output "export"), so every
# NEXT_PUBLIC_* value is baked into the JS bundle at BUILD time, not read at
# request time. On Netlify, set these under Site settings -> Environment
# variables, then trigger a new deploy for a changed value to take effect.

# Google Analytics 4 measurement ID (gtag). Leave unset to disable analytics.
NEXT_PUBLIC_ANALYTICS_ID=

# Microsoft Clarity project ID. Leave unset to disable Clarity.
# Only loads when NODE_ENV=production, so it never fires on `next dev`.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ConvertKit form IDs for the end-of-tool email capture (Ticket 2).
# Each is the numeric ID from that form's "Embed" code in the ConvertKit
# dashboard. Leave either unset to hide that tool's email capture entirely.
NEXT_PUBLIC_CONVERTKIT_ELIGIBILITY_FORM_ID=
NEXT_PUBLIC_CONVERTKIT_MATCHER_FORM_ID=

# ConvertKit form ID for the waitlist signup (homepage + /stage/considering).
# Tagging and the email sequence are configured inside ConvertKit. Create
# the custom fields "country" and "language" there before deploying.
# Leave unset to hide the waitlist signup entirely.
NEXT_PUBLIC_CONVERTKIT_WAITLIST_FORM_ID=
