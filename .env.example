# Copy this file to .env.local for local development.
# This is a static-export site (next.config.ts: output "export"), so every
# NEXT_PUBLIC_* value is baked into the JS bundle at BUILD time, not read at
# request time. On Netlify, set these under Site settings -> Environment
# variables, then trigger a new deploy for a changed value to take effect.

# Google Analytics 4 measurement ID (gtag). Leave unset to disable analytics.
NEXT_PUBLIC_ANALYTICS_ID=

# Microsoft Clarity project ID. Leave unset to disable Clarity.
# Only loads when NODE_ENV=production, so it never fires on `next dev`.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
