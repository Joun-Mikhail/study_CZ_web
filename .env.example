# Copy this file to .env.local for local development.
# This is a static-export site (next.config.ts: output "export"), so every
# NEXT_PUBLIC_* value is baked into the JS bundle at BUILD time, not read at
# request time. On Netlify, set these under Site settings -> Environment
# variables, then trigger a new deploy for a changed value to take effect.

# Umami website ID (cookieless analytics, no cookie banner needed).
# Recommended. Tracks page views, Stripe/WhatsApp clicks and tool completions.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Google Analytics and Microsoft Clarity were removed: both set cookies, which
# would need a consent banner first (CLAUDE.md rule 8). Umami above is cookieless.

# Email (Brevo). Sign-up boxes stay hidden until NEXT_PUBLIC_EMAIL_ENABLED=true.
# Set the secrets in Netlify (scope: Functions), never in the repo.
#   BREVO_API_KEY        Brevo > SMTP & API > API keys
#   EMAIL_FROM_ADDRESS   verified sender, e.g. john@studyczechia.com
#   EMAIL_FROM_NAME      e.g. "John from Study Czechia"
#   EMAIL_LINK_SECRET    signs unsubscribe links; generate: openssl rand -base64 48
NEXT_PUBLIC_EMAIL_ENABLED=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_LINK_SECRET=

# ConvertKit form ID for the waitlist signup (homepage + /stage/considering).
# Tagging and the email sequence are configured inside ConvertKit. Create
# the custom fields "country" and "language" there before deploying.
# Leave unset to hide the waitlist signup entirely.
NEXT_PUBLIC_CONVERTKIT_WAITLIST_FORM_ID=
